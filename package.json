{
  "name": "siyuan-linkmark",
  "version": "0.1.4",
  "description": "Automatically discovers, displays, and locally caches website icons for SiYuan links.",
  "private": false,
  "type": "module",
  "author": "霞葉 (Kasuha)",
  "license": "MIT",
  "repository": "https://github.com/kasuha07/siyuan-linkmark",
  "homepage": "https://github.com/kasuha07/siyuan-linkmark",
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --config vite.kernel.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:package": "node scripts/assert-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "sharp": "^0.35.3",
    "siyuan": "^1.0.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "tldts-experimental": "^7.4.10"
  }
}
