{
  "name": "siyuan-auto-favicon",
  "version": "0.5.7",
  "description": "Automatically fetch and cache favicons for SiYuan web links, with local fallbacks and smart compatibility with Link Icon.",
  "private": false,
  "type": "module",
  "author": "Acetab",
  "license": "MIT",
  "repository": "https://github.com/Acetab/auto-favicon",
  "homepage": "https://github.com/Acetab/auto-favicon",
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --config vite.kernel.config.ts",
    "check": "tsc --noEmit",
    "check:package": "node scripts/assert-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.3",
    "siyuan": "^1.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.2.7"
  }
}
