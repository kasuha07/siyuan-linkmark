{
  "name": "siyuan-linkmark",
  "version": "0.1.1",
  "description": "Automatically discovers, displays, and locally caches website icons for SiYuan links.",
  "private": false,
  "type": "module",
  "author": "霞葉 (Kasuha)",
  "license": "MIT",
  "repository": "https://github.com/kasuha07/siyuan-linkmark",
  "homepage": "https://github.com/kasuha07/siyuan-linkmark",
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build --config vite.kernel.config.ts",
    "check": "tsc --noEmit",
    "check:package": "node scripts/assert-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.35.3",
    "siyuan": "^1.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^3.2.7"
  }
}
