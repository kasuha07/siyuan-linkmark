{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "siyuan": ["src/siyuan.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts", "vite.kernel.config.ts"]
}
